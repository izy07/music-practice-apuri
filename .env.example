# Copy to .env and fill with real values. Never commit .env.

# Cloud Supabase (required for production / closed testing builds)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: use local Supabase instead
# EXPO_PUBLIC_USE_LOCAL_SUPABASE_WEB=true
# EXPO_PUBLIC_USE_LOCAL_SUPABASE=true
# EXPO_PUBLIC_SUPABASE_PORT=54321
# EXPO_PUBLIC_SUPABASE_LAN_IP=192.168.1.10
# EXPO_PUBLIC_SUPABASE_LOCAL_ANON_KEY=  # defaults to local demo anon key

# Optional web redirect override
# EXPO_PUBLIC_WEB_REDIRECT_URL=https://example.com/auth/callback
